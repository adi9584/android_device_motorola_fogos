# e-SIM
masterclear.allow_retain_esim_profiles_after_fdr=true
ro.telephony.esim_slot_id=1

# Google
ro.opa.device_model_id=motorola-fogos

# Motorola
ro.mot.build.customerid=global

# SKU specific properties
import /product/etc/hardware.sku.${ro.boot.hardware.sku}.prop

# Infinity X
ro.infinity.soc=Snapdragon 695
ro.infinity.camera=50MP + 2MP + 16MP
